# ===== SERVIDOR =====
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# ===== BANCO DE DADOS =====
# PostgreSQL local
DATABASE_URL="postgresql://usuario:senha@localhost:5432/oficina_costura?schema=public"

# ===== CORS =====
# URL do frontend em desenvolvimento
FRONTEND_URL=http://localhost:5173

# ===== UPLOAD =====
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# ===== EMAIL (Nodemailer) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
EMAIL_FROM="Linha & Ponto <contato@linhaeponto.com>"
EMAIL_TO=contato@linhaeponto.com

# ===== JWT (para futuro painel admin) =====
JWT_SECRET=troque-por-uma-chave-secreta-muito-longa-e-aleatoria
JWT_EXPIRES_IN=7d
